<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SideWave" Width="1060" Height="880" MinWidth="1000" MinHeight="640"
 Background="#141414" Foreground="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" ToolTipService.ShowDuration="30000"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" TextOptions.TextHintingMode="Auto"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <!-- 设计令牌：近黑底 + 深灰卡片 + 单一暖橙强调色（想换主题色只改 Accent / AccentText / AccentTint） -->
  <SolidColorBrush x:Key="Card" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="CardBorder" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="Inset" Color="#121212"/>
  <SolidColorBrush x:Key="InsetBorder" Color="#333333"/>
  <SolidColorBrush x:Key="InsetHover" Color="#555555"/>
  <SolidColorBrush x:Key="Hairline" Color="#292929"/>
  <SolidColorBrush x:Key="Text" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="TextDim" Color="#A9A9A9"/>
  <SolidColorBrush x:Key="TextFaint" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="BtnBg" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="BtnBorder" Color="#3E3E3E"/>
  <SolidColorBrush x:Key="Accent" Color="#FF8A4C"/>
  <SolidColorBrush x:Key="AccentText" Color="#1C1109"/>
  <SolidColorBrush x:Key="AccentTint" Color="#2A2019"/>
  <!-- 应用图标：与 tools/render_icons.py 生成的 ico/png 同一设计 -->
  <DrawingImage x:Key="IconApp"><DrawingImage.Drawing><DrawingGroup>
   <GeometryDrawing><GeometryDrawing.Geometry><RectangleGeometry Rect="1.5,1.5,253,253" RadiusX="55" RadiusY="55"/></GeometryDrawing.Geometry>
    <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A2A2E" Offset="0"/><GradientStop Color="#101012" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
    <GeometryDrawing.Pen><Pen Brush="#3E3E44" Thickness="3"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Geometry="M52,128 L54,125.4 L56,122.7 L58,120.1 L60,117.6 L62,115.1 L64,112.8 L66,110.5 L68,108.3 L70,106.3 L72,104.5 L74,102.7 L76,101.2 L78,99.9 L80,98.7 L82,97.7 L84,97 L86,96.4 L88,96.1 L90,96 L92,96.1 L94,96.4 L96,97 L98,97.7 L100,98.7 L102,99.9 L104,101.2 L106,102.7 L108,104.5 L110,106.3 L112,108.3 L114,110.5 L116,112.8 L118,115.1 L120,117.6 L122,120.1 L124,122.7 L126,125.4 L128,128 L130,130.6 L132,133.3 L134,135.9 L136,138.4 L138,140.9 L140,143.2 L142,145.5 L144,147.7 L146,149.7 L148,151.5 L150,153.3 L152,154.8 L154,156.1 L156,157.3 L158,158.3 L160,159 L162,159.6 L164,159.9 L166,160 L168,159.9 L170,159.6 L172,159 L174,158.3 L176,157.3 L178,156.1 L180,154.8 L182,153.3 L184,151.5 L186,149.7 L188,147.7 L190,145.5 L192,143.2 L194,140.9 L196,138.4 L198,135.9 L200,133.3 L202,130.6 L204,128"><GeometryDrawing.Pen><Pen Thickness="32" StartLineCap="Round" EndLineCap="Round" LineJoin="Round">
    <Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAA60" Offset="0"/><GradientStop Color="#EC542A" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>

  <!-- 文字与容器。字号层级：标题 20 · 分区 16 · 正文 14 · 标签/说明 12.5 -->
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource TextDim}"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource TextFaint}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <!-- 选项行：主标签略柔和，次要信息用浅灰小字跟在后面 -->
  <Style x:Key="OptionNote" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextFaint}"/><Setter Property="Margin" Value="8,1,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <!-- 只在有内容时占位：没有警告或遥测时整行隐藏 -->
  <Style x:Key="Notice" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
   <Setter Property="Foreground" Value="#FFB37E"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CardPanel" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="#262626" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="8" Padding="11,8" MaxWidth="380">
     <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style></ContentPresenter.Resources></ContentPresenter>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- 滚动条：细条、悬停变亮 -->
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border Name="Bar" Background="#474747" CornerRadius="3" Margin="3"/>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#6A6A6A"/></Trigger>
     <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="#8A8A8A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="VerticalScroll" TargetType="ScrollBar">
   <Grid Background="Transparent"><Track Name="PART_Track" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
   </Track></Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="HorizontalScroll" TargetType="ScrollBar">
   <Grid Background="Transparent"><Track Name="PART_Track" IsDirectionReversed="False">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
   </Track></Grid>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Template" Value="{StaticResource VerticalScroll}"/>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Horizontal">
     <Setter Property="Width" Value="NaN"/><Setter Property="Height" Value="12"/><Setter Property="Template" Value="{StaticResource HorizontalScroll}"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- 按钮：默认次要；Primary 强调；Quiet 底部工具；Segment 模式切换；Small 小号 -->
  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource BtnBg}"/><Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border Name="FocusRing" Margin="-3" CornerRadius="11" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Visibility="Collapsed"/>
     <Border Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <Border Name="HoverLayer" CornerRadius="8" Background="White" Opacity="0" IsHitTestVisible="False"/>
     <Border Name="PressLayer" CornerRadius="8" Background="Black" Opacity="0" IsHitTestVisible="False"/>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value=".08"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0"/><Setter TargetName="PressLayer" Property="Opacity" Value=".2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="{StaticResource AccentText}"/><Setter Property="FontWeight" Value="Medium"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Background" Value="{StaticResource BtnBg}"/><Setter Property="BorderBrush" Value="{StaticResource BtnBorder}"/><Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="13,6"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource TextDim}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,2,0"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="DangerQuietButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF8B7E"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SegmentButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextDim}"/>
   <Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Name="Segment" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="#262626"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Segment" Property="Background" Value="#3A3A3A"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- 设备列表项 -->
  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border Name="PeerChrome" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
     <Grid>
      <Border Name="PeerBar" Width="3" HorizontalAlignment="Left" Margin="-12,2,0,2" CornerRadius="2" Background="{StaticResource Accent}" Visibility="Collapsed"/>
      <ContentPresenter/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PeerChrome" Property="Background" Value="#222222"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="PeerChrome" Property="Background" Value="{StaticResource AccentTint}"/><Setter TargetName="PeerBar" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="4"/></Style>

  <!-- 文本框 -->
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{StaticResource Inset}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource InsetBorder}"/><Setter Property="Padding" Value="12,9"/>
   <Setter Property="CaretBrush" Value="{StaticResource Text}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionOpacity" Value=".45"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
     <ScrollViewer Name="PART_ContentHost" Focusable="False"
      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource InsetHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- 下拉框 -->
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="Background" Value="{StaticResource Inset}"/><Setter Property="BorderBrush" Value="{StaticResource InsetBorder}"/>
   <Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="11,8"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
      <ContentPresenter/>
     </Border><ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentTint}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <Border Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter IsHitTestVisible="False" Margin="13,8,36,8" VerticalAlignment="Center"
      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     <Path Name="Arrow" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
      Stroke="#BDBDBD" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0 0 L 4 4 L 8 0"/>
     <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" HorizontalOffset="-12" VerticalOffset="-4">
      <Grid Margin="12,8,12,18">
       <Border MinWidth="{TemplateBinding ActualWidth}" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="9" Padding="4">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity=".6" Color="Black"/></Border.Effect>
        <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
        </ScrollViewer>
       </Border>
      </Grid>
     </Popup>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource InsetHover}"/><Setter TargetName="Arrow" Property="Stroke" Value="#E0E0E0"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- 复选框：滑动开关 -->
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
     <Grid Grid.Column="1" Margin="16,0,0,0" Width="40" Height="22" VerticalAlignment="Center">
      <Border Name="SwitchRing" Margin="-3" CornerRadius="14" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Visibility="Collapsed"/>
      <Border Name="SwitchTrack" CornerRadius="11" Background="#333333" BorderBrush="#474747" BorderThickness="1"/>
      <Ellipse Name="SwitchThumb" Width="16" Height="16" Fill="#D2D2D2" HorizontalAlignment="Left" Margin="3,0,0,0">
       <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
      </Ellipse>
     </Grid>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#6A6A6A"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchRing" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource Accent}"/>
      <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter TargetName="SwitchThumb" Property="Fill" Value="White"/>
      <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
      <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="SwitchThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-18" To="0" Duration="0:0:0.14">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
       </DoubleAnimation>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="SwitchThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="18" To="0" Duration="0:0:0.14">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
       </DoubleAnimation>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OptionRow" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="Margin" Value="14,10"/><Setter Property="Foreground" Value="#E4E4E4"/>
  </Style>
 </Window.Resources>

 <Grid Margin="32,26,32,24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 顶部：身份 + 模式切换 -->
  <DockPanel Margin="0,0,0,20">
   <Border DockPanel.Dock="Right" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="11" Padding="3" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <Button Name="SendMode" Content="发送模式" Style="{StaticResource SegmentButton}"/>
     <Button Name="ReceiveMode" Content="接收模式" Style="{StaticResource SegmentButton}"/>
    </StackPanel>
   </Border>
   <ComboBox Name="LanguageChoice" DockPanel.Dock="Right" AutomationProperties.Name="语言 / Language" ToolTip="语言 / Language" Width="112" MinHeight="36" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="13">
    <ComboBoxItem Content="中文"/><ComboBoxItem Content="English"/>
   </ComboBox>
   <Image Name="RoleIcon" Width="40" Height="40" Margin="0,0,14,0" DockPanel.Dock="Left"/>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Name="Heading" Text="SideWave" FontSize="20" FontWeight="SemiBold"/>
   </StackPanel>
  </DockPanel>

  <!-- 主体 -->
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid>
    <Grid Name="HostPanel">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

     <Border Style="{StaticResource CardPanel}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel>
        <Button Name="Scan" AutomationProperties.Name="刷新" Content="刷新" Style="{StaticResource SmallButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        <TextBlock Text="可用副机" Style="{StaticResource Section}" VerticalAlignment="Center"/>
       </DockPanel>
       <Border Grid.Row="1" Margin="0,14,0,18" MinHeight="120" Background="{StaticResource Inset}" BorderBrush="{StaticResource InsetBorder}" BorderThickness="1" CornerRadius="10">
        <Grid>
         <ListBox Name="Devices" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate>
           <DockPanel>
            <Border DockPanel.Dock="Right" Background="#242424" CornerRadius="6" Padding="9,3" VerticalAlignment="Center" Margin="12,0,0,0">
             <TextBlock FontSize="12" Foreground="{StaticResource TextDim}"><Run Text="{Binding Width,Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Height,Mode=OneWay}"/></TextBlock>
            </Border>
            <StackPanel>
             <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Ip}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
            </StackPanel>
           </DockPanel>
          </DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <StackPanel Name="NoDevices" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="24,0">
          <TextBlock Text="暂无设备" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}"/>
          <TextBlock Text="副机需处于接收模式，并已允许专用网络。" Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
           <DataTrigger Binding="{Binding HasItems,ElementName=Devices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></StackPanel.Style>
         </StackPanel>
        </Grid>
       </Border>
       <StackPanel Grid.Row="2">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="IP 地址" Style="{StaticResource Label}"/>
          <TextBox Name="Address" Margin="0,6,0,0" AutomationProperties.Name="副机IP地址" ToolTip="也可以从设备列表选择"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="配对码（首次连接）" Style="{StaticResource Label}"/>
          <TextBox Name="PairCode" Margin="0,6,0,0" AutomationProperties.Name="配对码" MaxLength="24" ToolTip="输入副机显示的配对码；已配对设备留空"/>
         </StackPanel>
        </Grid>
        <Grid Margin="0,16,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button Name="Connect" AutomationProperties.Name="连接副机" Content="连接副机" Style="{StaticResource PrimaryButton}" Padding="18,11" Margin="0,0,8,0"/>
         <Button Name="Disconnect" Grid.Column="1" AutomationProperties.Name="断开" Content="断开" IsEnabled="False" Padding="18,11" Margin="0"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,14"/>
        <CheckBox Name="AutoConnect" Content="启动时自动连接上次副机"/>
       </StackPanel>
      </Grid>
     </Border>

     <Border Grid.Column="2" Style="{StaticResource CardPanel}">
      <StackPanel>
       <TextBlock Text="画面设置" Style="{StaticResource Section}"/>
       <TextBlock Text="分辨率" Style="{StaticResource Label}" Margin="0,16,0,0"/>
       <ComboBox Name="Resolution" AutomationProperties.Name="分辨率" ToolTip="是否可用取决于虚拟屏驱动；失败时恢复原模式。" MaxDropDownHeight="340"/>
       <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="目标帧率" Style="{StaticResource Label}"/>
         <ComboBox Name="FrameRate" AutomationProperties.Name="帧率">
          <ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="120 FPS"/>
          <ComboBoxItem Content="165 FPS"/><ComboBoxItem Content="240 FPS"/>
         </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="画质" Style="{StaticResource Label}"/>
         <ComboBox Name="Quality">
          <ComboBoxItem Content="均衡 · 400 Mbps"/><ComboBoxItem Content="清晰 · 600 Mbps"/>
          <ComboBoxItem Content="高画质 · 750 Mbps"/><ComboBoxItem Content="极高画质 · 900 Mbps"/>
         </ComboBox>
        </StackPanel>
       </Grid>
       <TextBlock Name="BandwidthNote" Text="" Style="{StaticResource Notice}" Margin="0,10,0,0"/>
       <Button Name="Apply" AutomationProperties.Name="应用画面设置" Content="应用画面设置" Style="{StaticResource PrimaryButton}" Padding="18,10" Margin="0,14,0,0" IsEnabled="False"
        ToolTip="切换参数保留控制连接，画面会短暂停顿。&#10;静止画面也持续发送；实际刷新受屏幕硬件限制。"/>
       <TextBlock Text="传输选项" Style="{StaticResource Label}" Margin="0,20,0,8"/>
       <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource InsetBorder}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
         <CheckBox Name="VideoEncryption" Style="{StaticResource OptionRow}" ToolTip="关闭后使用明文 UDP 视频，减少逐包加解密开销；点应用后生效。">
          <TextBlock Text="视频加密"/>
         </CheckBox>
         <Border Height="1" Background="{StaticResource Hairline}"/>
         <CheckBox Name="AllowTearing" Style="{StaticResource OptionRow}" ToolTip="减少呈现等待；可能出现画面撕裂。LAT 使用系统显示采样，包含渲染和显示等待；不包含面板响应。点应用后生效。">
          <StackPanel Orientation="Horizontal"><TextBlock Text="低延迟显示"/><TextBlock Text="允许撕裂" Style="{StaticResource OptionNote}"/></StackPanel>
         </CheckBox>
         <Border Height="1" Background="{StaticResource Hairline}"/>
         <CheckBox Name="PartialFrames" Style="{StaticResource OptionRow}" ToolTip="桌面只有局部变化时只编码并发送变化区域，减少传输时间和带宽；全屏运动时自动发送整帧。需要副机也升级到支持此功能的版本。点应用后生效。">
          <TextBlock Text="只传输变化区域"/>
         </CheckBox>
         <Border Height="1" Background="{StaticResource Hairline}"/>
         <CheckBox Name="ClientCursor" Style="{StaticResource OptionRow}" ToolTip="主机鼠标位置和形状单独发送，副机用自己的系统硬件光标显示，不再等待视频编码和解码；画面里不再合成主机光标。副机切到其他程序时不移动其鼠标。需要副机也升级。点应用后生效。">
          <StackPanel Orientation="Horizontal"><TextBlock Text="副机硬件光标"/>
           <Border Background="{StaticResource AccentTint}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="实验" FontSize="11" Foreground="{StaticResource Accent}"/></Border>
          </StackPanel>
         </CheckBox>
         <Border Height="1" Background="{StaticResource Hairline}"/>
         <CheckBox Name="PacketProtection" Style="{StaticResource OptionRow}" ToolTip="每个视频数据包增加一片校验数据，可恢复一片丢失；点应用后生效。">
          <StackPanel Orientation="Horizontal"><TextBlock Text="丢包保护"/><TextBlock Text="FEC" Style="{StaticResource OptionNote}"/></StackPanel>
         </CheckBox>
        </StackPanel>
       </Border>
      </StackPanel>
     </Border>
    </Grid>

    <Border Name="ClientPanel" Visibility="Collapsed" Style="{StaticResource CardPanel}" Padding="34" Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
     <StackPanel>
      <TextBlock Text="让这台电脑成为副屏" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Name="ClientAddresses" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="首次配对码 · 10 分钟有效" Style="{StaticResource Label}" Margin="0,26,0,8"/>
      <TextBox Name="ClientCode" IsReadOnly="True" TextAlignment="Center" FontFamily="Bahnschrift, Consolas" FontSize="30" Padding="16,14" AutomationProperties.Name="客户端配对码"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
       <Button Name="CopyCode" Content="复制配对码" Style="{StaticResource PrimaryButton}"/><Button Name="RenewCode" Content="刷新配对码"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>

  <!-- 底部：状态 / 遥测 / 偏好 / 维护 -->
  <StackPanel Grid.Row="2" Margin="0,18,0,0">
   <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11">
    <DockPanel>
     <Border DockPanel.Dock="Right" Background="{StaticResource Inset}" BorderBrush="{StaticResource InsetBorder}" BorderThickness="1" CornerRadius="7" Padding="11,4" Margin="16,0,0,0" VerticalAlignment="Center">
      <Border.Style><Style TargetType="Border"><Style.Triggers>
       <DataTrigger Binding="{Binding Text,ElementName=Telemetry}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></Border.Style>
      <TextBlock Name="Telemetry" Text="" Foreground="#D6D6D6" FontSize="12.5" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Name="Status" Text="正在初始化…" TextWrapping="Wrap" Foreground="#F0F0F0" VerticalAlignment="Center"/>
    </DockPanel>
   </Border>
   <DockPanel Margin="4,14,0,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Name="Firewall" Content="网络设置" Style="{StaticResource QuietButton}" ToolTip="检查网络类型与防火墙规则，修复连接配置。"/>
     <Button Name="Driver" Content="虚拟屏驱动" Style="{StaticResource QuietButton}"/>
     <Button Name="Diagnostics" Content="诊断" Style="{StaticResource QuietButton}"/>
     <Button Name="Forget" Content="忘记配对" Style="{StaticResource DangerQuietButton}"/>
     <Border Width="1" Height="18" Background="{StaticResource Hairline}" Margin="6,0,8,0"/>
     <Button Name="Exit" Content="退出" Style="{StaticResource DangerQuietButton}" Margin="0"/>
    </StackPanel>
    <CheckBox Name="Startup" Content="随 Windows 启动" HorizontalAlignment="Left" VerticalAlignment="Center"/>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
